{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/dukka/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "builder": "rspack",
    "tsConfigPath": "apps/dukka/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/dukka",
  "projects": {
    "dukka": {
      "type": "application",
      "root": "apps/dukka",
      "entryFile": "main",
      "sourceRoot": "apps/dukka/src",
      "compilerOptions": {
        "tsConfigPath": "apps/dukka/tsconfig.app.json"
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "mail_worker": {
      "type": "application",
      "root": "apps/mail_worker",
      "entryFile": "main",
      "sourceRoot": "apps/mail_worker/src",
      "compilerOptions": {
        "tsConfigPath": "apps/mail_worker/tsconfig.app.json",
        "assets": [
          "mail/templates/**/*"
        ],
        "watchAssets": true
      }
    },
    "queues": {
      "type": "library",
      "root": "libs/queues",
      "entryFile": "index",
      "sourceRoot": "libs/queues/src",
      "compilerOptions": {
        "tsConfigPath": "libs/queues/tsconfig.lib.json"
      }
    },
    "utils": {
      "type": "library",
      "root": "libs/utils",
      "entryFile": "index",
      "sourceRoot": "libs/utils/src",
      "compilerOptions": {
        "tsConfigPath": "libs/utils/tsconfig.lib.json"
      }
    }
  }
}
