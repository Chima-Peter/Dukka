NODE_ENV=development
DUKKA_PORT=8000

DATABASE_URL=postgresql://user:password@host:5432/dukka?schema=public
DIRECT_URL=postgresql://user:password@host:5432/dukka?schema=public

REDIS_URL=redis://127.0.0.1:6379
REDIS_MAXMEMORY=256mb
REDIS_MAXMEMORY_POLICY=allkeys-lru
REDIS_PUBLISH_PORT=6379
DUKKA_PUBLISH_PORT=8000

JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
STAFF_JWT_PRIVATE_KEY_PATH=./keys/staff-private.pem
STAFF_JWT_PUBLIC_KEY_PATH=./keys/staff-public.pem

OBSERVE_SERVICE_NAME=dukka-api
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKETS=avatars,products,reviews,qualifications

STAFF_APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
TRUST_PROXY=false
CSRF_EXCLUDE=/api/v1/dukka/docs

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co

REST_COUNTRIES_API_KEY=

MAIL_FROM=noreply@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
