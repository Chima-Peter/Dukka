// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TokenType {
  ACCESS
  REFRESH
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model Customer {
  id        String   @id @default(uuid())
  name      String
  avatar    String?
  email     String   @unique
  password  String
  date_of_birth  DateTime?
  gender        Gender?
  phone_number  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  active_market_id String?
  active_market    Market? @relation(fields: [active_market_id], references: [id], onDelete: SetNull)

  points    Points?
  cart    Cart?
  
  tokens Token[]
  shipping_address    ShippingAddress[]
  billing_address     BillingAddress[]
  reviews Reviews[]
  orders  Order[]
  notifications Notification[]
  promotion_usages PromotionUsage[]
  coupon_usages CouponUsage[]

  @@index([active_market_id])
}

model Token {
  id         String    @id @default(uuid())
  token      String    @unique
  type       TokenType
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([customerId, type])
}

model ShippingAddress {
  id              String  @id @default(uuid())
  first_name      String
  last_name       String
  email           String
  phone_number    String
  whatsapp_number String?
  country         String
  street_address  String

  state         String
  service_state ServiceState @relation(fields: [state], references: [id], onDelete: Cascade)

  market_id String
  market    Market @relation(fields: [market_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  customer_id String
  customer    Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)

  @@index([customer_id])
  @@index([market_id])
  @@index([state])
}

model BillingAddress {
  id              String  @id @default(uuid())
  first_name      String
  last_name       String
  email           String
  phone_number    String
  whatsapp_number String?
  country         String
  street_address  String

  state         String
  service_state ServiceState @relation(fields: [state], references: [id], onDelete: Cascade)

  market_id String
  market    Market @relation(fields: [market_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  customer_id String
  customer    Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)

  @@index([customer_id])
  @@index([market_id])
  @@index([state])
}

model Points {
  id    String    @id @default(ulid())
  balance   Int   @default(0)

  created_at    DateTime    @default(now())
  updated_at    DateTime    @updatedAt

  points_history PointsHistory[]

  customer_id   String    @unique
  customer    Customer    @relation(fields: [customer_id], references: [id], onDelete: Cascade)
}

enum POINT_STATUS {
  REDEEMED
  EARNED
}

enum POINT_REASON {
  COMPLETE_ORDER
  PLACE_ORDER
  GAME
  APP_NOTIFICATION
  SUBSCRIBED
  REGISTERED
}

model PointsHistory {
  id    String    @id @default(uuid())
  status    POINT_STATUS
  description   POINT_REASON
  count     Int

  created_at    DateTime    @default(now())
  updated_at    DateTime    @updatedAt

  points_id   String
  points    Points    @relation(fields: [points_id], references: [id], onDelete: Cascade)
}

model Staff {
  id            String   @id @default(uuid())
  name          String
  avatar        String?
  email         String   @unique
  password      String
  phone_number  String?
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  role_id String?
  role    Role?  @relation(fields: [role_id], references: [id])

  profile          StaffProfile?
  qualifications   Qualification[]
  tokens           StaffToken[]
  staff_markets    StaffMarket[]
  invitations_sent StaffInvitation[] @relation("StaffInvitationsSent")
  invitation       StaffInvitation?  @relation("StaffInvitationAccepted")
  warehouses       Warehouse[]
  notifications    Notification[]
}

model StaffToken {
  id         String    @id @default(uuid())
  token      String    @unique
  type       TokenType
  staffId    String
  staff      Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([staffId, type])
}

model StaffProfile {
  id            String    @id @default(uuid())
  job_title     String?
  bio           String?
  date_of_birth DateTime?
  gender        Gender?
  address       String?
  hire_date     DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  staff_id String @unique
  staff    Staff  @relation(fields: [staff_id], references: [id], onDelete: Cascade)
}

model Qualification {
  id           String    @id @default(uuid())
  title        String
  description  String?
  document_url String?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  staff_id String
  staff    Staff  @relation(fields: [staff_id], references: [id], onDelete: Cascade)

  @@index([staff_id])
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  hierarchy   Int      @default(1)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  staff            Staff[]
  invitations      StaffInvitation[]
  role_permissions RolePermission[]
  role_markets     RoleMarket[]
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  role_permissions RolePermission[]
}

model Currency {
  id         String   @id @default(uuid())
  code       String   @unique
  name       String
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  market Market?
}

enum ServiceCountryStatus {
  PENDING
  OPEN
  CLOSED
}

model ServiceCountry {
  id         String               @id @default(uuid())
  name       String
  iso2       String               @unique @db.Char(2)
  iso3       String               @unique @db.Char(3)
  status     ServiceCountryStatus @default(PENDING)
  market_id  String?
  created_at DateTime             @default(now())
  updated_at DateTime             @updatedAt

  market         Market?        @relation(fields: [market_id], references: [id], onDelete: Restrict)
  service_states ServiceState[]
  warehouses     Warehouse[]

  @@index([market_id])
  @@index([status])
  @@index([id, status])
}

enum MarketStatus {
  PENDING
  OPEN
  CLOSED
}

model Market {
  id          String       @id @default(uuid())
  name        String
  code        String       @unique
  currency_id String       @unique
  status      MarketStatus @default(PENDING)
  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt

  currency            Currency @relation(fields: [currency_id], references: [id], onDelete: Restrict)
  service_countries   ServiceCountry[]
  role_markets        RoleMarket[]
  staff_markets       StaffMarket[]
  invitation_markets  StaffInvitationMarket[]
  market_categories   MarketCategory[]
  market_variants     MarketVariant[]
  shipping_addresses  ShippingAddress[]
  billing_addresses   BillingAddress[]
  market_payment_methods MarketPaymentMethod[]
  orders              Order[]
  customers           Customer[]
  promotion_markets   PromotionMarket[]

  @@index([status])
  @@index([id, status])
}

enum StaffInvitationStatus {
  PENDING
  ACCEPTED
  CANCELLED
  EXPIRED
}

model StaffInvitation {
  id           String                @id @default(uuid())
  email        String
  name         String
  phone_number String?
  token        String                @unique
  status       StaffInvitationStatus @default(PENDING)
  expires_at   DateTime
  accepted_at  DateTime?
  cancelled_at DateTime?
  created_at   DateTime              @default(now())
  updated_at   DateTime              @updatedAt

  role_id String
  role    Role   @relation(fields: [role_id], references: [id], onDelete: Restrict)

  invited_by_staff_id String
  invited_by          Staff  @relation("StaffInvitationsSent", fields: [invited_by_staff_id], references: [id], onDelete: Restrict)

  staff_id String? @unique
  staff    Staff?  @relation("StaffInvitationAccepted", fields: [staff_id], references: [id], onDelete: SetNull)

  invitation_markets StaffInvitationMarket[]

  @@index([email])
  @@index([status])
  @@index([expires_at])
  @@index([invited_by_staff_id])
  @@index([role_id])
}

model StaffInvitationMarket {
  id         String   @id @default(uuid())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  invitation_id String
  invitation    StaffInvitation @relation(fields: [invitation_id], references: [id], onDelete: Cascade)

  market_id String
  market    Market @relation(fields: [market_id], references: [id], onDelete: Restrict)

  @@unique([invitation_id, market_id])
  @@index([market_id])
}

model StaffMarket {
  id         String   @id @default(uuid())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  staff_id String
  staff    Staff  @relation(fields: [staff_id], references: [id], onDelete: Cascade)

  market_id String
  market    Market @relation(fields: [market_id], references: [id], onDelete: Restrict)

  @@unique([staff_id, market_id])
  @@index([market_id])
}

model RoleMarket {
  id         String   @id @default(uuid())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  role_id String
  role    Role   @relation(fields: [role_id], references: [id], onDelete: Restrict)

  market_id String
  market    Market @relation(fields: [market_id], references: [id], onDelete: Restrict)

  @@unique([role_id, market_id])
  @@index([market_id])
}

model RolePermission {
  id         String   @id @default(uuid())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  role_id String
  role    Role @relation(fields: [role_id], references: [id], onDelete: Restrict)

  permission_id String
  permission    Permission @relation(fields: [permission_id], references: [id], onDelete: Restrict)

  @@unique([role_id, permission_id])
  @@index([permission_id])
}

enum StaffAuditAction {
  STAFF_CREATED
  STAFF_DEACTIVATED
  ROLE_ASSIGNED
  ROLE_CHANGED
  ROLE_REVOKED
  MARKET_ASSIGNED
  MARKET_REMOVED
  PERMISSION_ASSIGNED
  PERMISSION_REMOVED
}

model StaffAudit {
  id         String           @id @default(uuid())
  action     StaffAuditAction
  created_at DateTime         @default(now())

  staff_id   String?
  staff_name String?

  performed_by_staff_id   String
  performed_by_staff_name String

  role_id   String?
  role_name String?

  previous_role_id   String?
  previous_role_name String?

  market_id       String?
  market_name     String?
  permission_id   String?
  permission_name String?

  @@index([staff_id])
  @@index([performed_by_staff_id])
  @@index([role_id])
  @@index([created_at])
  @@map("staff_audit")
}

model Category {
  id   String @id @default(uuid())
  name String @unique

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  market_categories MarketCategory[]
  products          Product[]
}

model MarketCategory {
  id String @id @default(uuid())

  market_id   String
  market      Market   @relation(fields: [market_id], references: [id], onDelete: Restrict)
  category_id String
  category    Category @relation(fields: [category_id], references: [id], onDelete: Restrict)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([market_id, category_id])
}

enum ProductStatus {
  PENDING_REVIEW
  ACTIVE
  REJECTED
  ARCHIVED
}

enum VariantStatus {
  PENDING_REVIEW
  ACTIVE
  REJECTED
  ARCHIVED
}

model Product {
  id          String        @id @default(uuid())
  name        String
  description String
  specs       Json
  status      ProductStatus @default(PENDING_REVIEW)

  images          ProductImage[]
  variants        Variant[]
  pending_updates ProductPendingUpdate[]

  category_id String
  category    Category @relation(fields: [category_id], references: [id], onDelete: Restrict)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

enum ProductPendingUpdateStatus {
  PENDING
  APPROVED
  REJECTED
}

model ProductPendingUpdate {
  id     String                     @id @default(uuid())
  status ProductPendingUpdateStatus @default(PENDING)

  name        String?
  description String?
  specs       Json?
  category_id String?
  images      Json?

  product_id String
  product    Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([status])
  @@index([created_at])
  @@index([product_id, status])
}

model ProductImage {
  id         String @id @default(uuid())
  image_url  String
  sort_order Int    @default(0)

  product_id String
  product    Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Variant {
  id           String        @id @default(uuid())
  variant_code String        @unique
  image        VariantImage?
  color        String?
  size         String?
  variant_info Json
  status       VariantStatus @default(PENDING_REVIEW)

  product_id String
  product    Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  market_variants MarketVariant[]
  pending_updates VariantPendingUpdate[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

enum VariantPendingUpdateStatus {
  PENDING
  APPROVED
  REJECTED
}

model VariantPendingUpdate {
  id     String                      @id @default(uuid())
  status VariantPendingUpdateStatus  @default(PENDING)

  variant_code String?
  color        String?
  size         String?
  variant_info Json?
  image_url    String?

  variant_id String
  variant    Variant @relation(fields: [variant_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([status])
  @@index([created_at])
  @@index([variant_id, status])
}

model VariantImage {
  id        String @id @default(uuid())
  image_url String

  variant_id String  @unique
  variant    Variant @relation(fields: [variant_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

enum MarketVariantStatus {
  ACTIVE
  CLOSED
}

model MarketVariant {
  id       String              @id @default(uuid())
  price    Decimal             @db.Decimal(12, 2)
  currency String
  sold_out Boolean             @default(false)
  status   MarketVariantStatus @default(ACTIVE)

  market_id  String
  market     Market  @relation(fields: [market_id], references: [id], onDelete: Restrict)
  variant_id String
  variant    Variant @relation(fields: [variant_id], references: [id], onDelete: Cascade)

  inventories          Inventory[]
  inventory_line_items InventoryLineItem[]
  reviews              Reviews[]
  cart_item            CartItems[]
  order_items OrderItems[]
  promotion_market_variants PromotionMarketVariant[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([market_id, variant_id])
  @@index([status])
}

enum WarehouseStatus {
  PENDING
  OPEN
  CLOSED
}

model Warehouse {
  id         String          @id @default(uuid())
  country_id String
  country    ServiceCountry  @relation(fields: [country_id], references: [id], onDelete: Restrict)
  name       String
  manager_id String
  manager    Staff           @relation(fields: [manager_id], references: [id], onDelete: Restrict)
  address    String
  status     WarehouseStatus @default(PENDING)

  inventory                Inventory[]
  order_inventories        OrderInventory[]
  orders                   Order[]
  warehouse_service_states WarehouseServiceState[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([country_id])
  @@index([status])
}

enum ServiceStateStatus {
  PENDING
  OPEN
  CLOSED
}

model ServiceState {
  id         String             @id @default(uuid())
  country_id String
  country    ServiceCountry     @relation(fields: [country_id], references: [id], onDelete: Restrict)
  state_name String
  status     ServiceStateStatus @default(PENDING)
  created_at DateTime           @default(now())
  updated_at DateTime           @updatedAt

  warehouse_service_states WarehouseServiceState[]
  shipping_addresses       ShippingAddress[]
  billing_addresses        BillingAddress[]

  @@unique([country_id, state_name])
  @@index([country_id])
  @@index([status])
}

model WarehouseServiceState {
  id         String   @id @default(uuid())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  warehouse_id String
  warehouse    Warehouse @relation(fields: [warehouse_id], references: [id], onDelete: Cascade)

  service_state_id String
  service_state    ServiceState @relation(fields: [service_state_id], references: [id], onDelete: Cascade)

  @@unique([warehouse_id, service_state_id])
  @@index([service_state_id])
}

model Inventory {
  id                 String @id @default(uuid())
  available_quantity Int    @default(0)
  reserved_quantity  Int    @default(0)

  low_stock_reminder_sent    Boolean   @default(false)
  low_stock_reminder_sent_at DateTime?
  finished_reminder_sent     Boolean   @default(false)
  finished_reminder_sent_at  DateTime?
  
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  market_variant_id String
  market_variant    MarketVariant @relation(fields: [market_variant_id], references: [id], onDelete: Cascade)
  warehouse_id      String
  warehouse         Warehouse     @relation(fields: [warehouse_id], references: [id], onDelete: Cascade)

  @@unique([market_variant_id, warehouse_id])
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id         String   @id @default(uuid())
  order_number String @unique
  status OrderStatus @default(PENDING)

  currency String
  subtotal Decimal @db.Decimal(12, 2)
  shipping_fee Decimal @db.Decimal(12, 2)
  discount_amount Decimal @db.Decimal(12, 2)
  points_discount Decimal @db.Decimal(12, 2)
  coupon_discount Decimal @db.Decimal(12, 2)
  total_amount Decimal @db.Decimal(12, 2)

  guest_email String?
  guest_name String?
  guest_phone_number String?

  shipping_address Json
  billing_address Json

  market_id String
  market    Market @relation(fields: [market_id], references: [id], onDelete: Restrict)

  warehouse_id String
  warehouse    Warehouse @relation(fields: [warehouse_id], references: [id], onDelete: Restrict)

  customer_id   String?
  customer      Customer?    @relation(fields: [customer_id], references: [id], onDelete: SetNull)

  order_inventory OrderInventory?
  order_payment_attempt OrderPaymentAttempt?
  order_items OrderItems[]
  promotion_usages PromotionUsage[]
  coupon_usages CouponUsage[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([market_id])
  @@index([warehouse_id])
  @@index([customer_id])
}

model OrderItems {
  id         String   @id @default(uuid())
  quantity   Int
  price      Decimal @db.Decimal(12, 2)
  total Decimal @db.Decimal(12, 2)

  product_name String
  product_image String
  product_specs Json

  order_id String
  order    Order @relation(fields: [order_id], references: [id], onDelete: Cascade)

  market_variant_id String?
  market_variant    MarketVariant? @relation(fields: [market_variant_id], references: [id], onDelete: Restrict)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

enum OrderInventoryStatus {
  PENDING
  CLOSED
  SUCCESS
}

model OrderInventory {
  id         String   @id @default(uuid())
  status     OrderInventoryStatus   @default(PENDING)

  created_at  DateTime @default(now())
  expires_at  DateTime
  updated_at  DateTime @updatedAt

  order_id String @unique
  order    Order  @relation(fields: [order_id], references: [id], onDelete: Cascade)

  warehouse_id String
  warehouse    Warehouse @relation(fields: [warehouse_id], references: [id], onDelete: Restrict)

  line_items InventoryLineItem[]

  @@index([warehouse_id])
}

model InventoryLineItem {
  id         String   @id @default(uuid())
  quantity   Int
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  order_inventory_id String
  order_inventory    OrderInventory @relation(fields: [order_inventory_id], references: [id], onDelete: Cascade)

  market_variant_id String
  market_variant    MarketVariant @relation(fields: [market_variant_id], references: [id], onDelete: Cascade)

  @@unique([order_inventory_id, market_variant_id])
  @@index([market_variant_id])
}

model PaymentMethod {
  id         String   @id @default(uuid())
  name       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([name])

  market_payment_methods MarketPaymentMethod[]
}

model MarketPaymentMethod {
  id         String   @id @default(uuid())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  market_id String
  market    Market @relation(fields: [market_id], references: [id], onDelete: Restrict)

  payment_method_id String
  payment_method    PaymentMethod @relation(fields: [payment_method_id], references: [id], onDelete: Restrict)

  order_payment_attempts OrderPaymentAttempt[]

  @@unique([market_id, payment_method_id])
  @@index([market_id])
  @@index([payment_method_id])
}

enum OrderPaymentAttemptStatus {
  PENDING
  SUCCESS
  FAILED
}

model OrderPaymentAttempt {
  id         String   @id @default(uuid())
  payment_intent_id String?
  payment_intent_url String?
  status OrderPaymentAttemptStatus @default(PENDING)
  payment_method_name String
  expires_at DateTime

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  order_id String @unique
  order    Order @relation(fields: [order_id], references: [id], onDelete: Cascade)

  market_payment_method_id String?
  market_payment_method    MarketPaymentMethod? @relation(fields: [market_payment_method_id], references: [id], onDelete: SetNull)

  @@index([market_payment_method_id])
  @@index([payment_method_name])
  @@index([status])
  @@index([expires_at])
}

model Reviews {
  id          String   @id @default(uuid())
  customer_id String?
  customer    Customer? @relation(fields: [customer_id], references: [id], onDelete: SetNull)
  customer_name String
  title       String
  review      String
  rating      Int
  likes       Int?     @default(0)
  dislikes    Int?     @default(0)

  review_images ReviewsImages[]

  market_variant_id String
  market_variant    MarketVariant @relation(fields: [market_variant_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
}

model ReviewsImages {
  id        String @id @default(uuid())
  image_url String

  review_id String
  review    Reviews @relation(fields: [review_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Cart {
  id    String  @id @default(uuid())
  total Decimal @default(0) @db.Decimal(12, 2)

  items CartItems[]

  customer_id String?   @unique
  customer    Customer? @relation(fields: [customer_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model CartItems {
  id       String @id @default(uuid())
  quantity Int    @default(1)

  cart_id String
  cart    Cart   @relation(fields: [cart_id], references: [id], onDelete: Cascade)

  market_variant_id String
  market_variant    MarketVariant @relation(fields: [market_variant_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([cart_id, market_variant_id])
  @@index([cart_id])
  @@index([market_variant_id])
}

enum NotificationType {
  ORDER
  PROMO
  SYSTEM
  POINTS
  MARKET
  LOGISTICS
}

model Notification {
  id    String           @id @default(uuid())
  title String
  type  NotificationType
  text  String
  has_read Boolean @default(false)
  stream_id String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  read_at    DateTime?

  customer_id String?
  customer    Customer? @relation(fields: [customer_id], references: [id], onDelete: Cascade)

  staff_id String?
  staff    Staff? @relation(fields: [staff_id], references: [id], onDelete: Cascade)

  @@index([customer_id])
  @@index([staff_id])
  @@index([type])
  @@index([has_read])
  @@index([created_at])
  @@index([customer_id, stream_id])
  @@index([staff_id, stream_id])
}

enum PromotionStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

model Promotion {
  id String @id @default(uuid())
  name String
  description String
  code String @unique
  status PromotionStatus @default(ACTIVE)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  discount_id String
  discount Discount @relation(fields: [discount_id], references: [id], onDelete: Restrict)

  promotion_markets PromotionMarket[]

  @@index([discount_id])
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

model Discount {
  id String @id @default(uuid())
  type DiscountType
  value Decimal @db.Decimal(12, 2)
  max_discount_amount Decimal @db.Decimal(12, 2)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  promotions Promotion[]
}

enum PromotionMarketStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

model PromotionMarket {
  id String @id @default(uuid())
  status PromotionMarketStatus @default(ACTIVE)

  start_date DateTime
  end_date DateTime

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  promotion_id String
  promotion Promotion @relation(fields: [promotion_id], references: [id], onDelete: Cascade)

  market_id String
  market Market @relation(fields: [market_id], references: [id], onDelete: Restrict)

  promotion_market_variants PromotionMarketVariant[]
  promotion_usages PromotionUsage[]

  @@unique([promotion_id, market_id])
  @@index([promotion_id])
  @@index([market_id])
  @@index([start_date, end_date])
}

model PromotionMarketVariant {
  id String @id @default(uuid())

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  promotion_market_id String
  promotion_market PromotionMarket @relation(fields: [promotion_market_id], references: [id], onDelete: Cascade)

  variant_id String
  variant MarketVariant @relation(fields: [variant_id], references: [id], onDelete: Restrict)

  @@unique([promotion_market_id, variant_id])
  @@index([promotion_market_id])
  @@index([variant_id])
}

model PromotionUsage {
  id String @id @default(uuid())
  discount_amount Decimal @db.Decimal(12, 2)

  redeemed_at DateTime
  
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  promotion_market_id String
  promotion_market PromotionMarket @relation(fields: [promotion_market_id], references: [id], onDelete: Restrict)

  order_id String?
  order Order? @relation(fields: [order_id], references: [id], onDelete: SetNull)

  customer_id String?
  customer Customer? @relation(fields: [customer_id], references: [id], onDelete: SetNull)

  @@index([promotion_market_id])
  @@index([order_id])
  @@index([customer_id])
}

enum CouponStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

enum CouponType {
  FIXED
  PERCENTAGE
}

model Coupon {
  id String @id @default(uuid())
  code String @unique
  type CouponType
  value Decimal @db.Decimal(12, 2)
  max_discount_amount Decimal @db.Decimal(12, 2)
  status CouponStatus @default(ACTIVE)
  expires_at DateTime

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  coupon_usages CouponUsage[]
}

model CouponUsage {
  id String @id @default(uuid())
  guest_email String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  coupon_id String
  coupon Coupon @relation(fields: [coupon_id], references: [id], onDelete: Cascade)

  customer_id   String?
  customer   Customer?     @relation(fields: [customer_id], references: [id], onDelete: SetNull)

  order_id String?
  order Order? @relation(fields: [order_id], references: [id], onDelete: SetNull)

  @@unique([coupon_id, customer_id])
  @@index([coupon_id])
  @@index([customer_id])
  @@index([order_id])
}