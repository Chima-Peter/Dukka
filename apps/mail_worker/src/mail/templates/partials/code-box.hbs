<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:8px 0 20px;background:#F5F6F5;border:1px solid #D5DADA;">
  <tr>
    <td align="center" style="padding:22px 16px;">
      {{#if label}}
      <p style="margin:0 0 10px;font-size:12px;font-weight:600;letter-spacing:0.16em;text-transform:uppercase;color:#888B8B;">
        {{label}}
      </p>
      {{/if}}
      <p style="margin:0;font-size:28px;font-weight:700;letter-spacing:0.18em;line-height:1.2;color:#031815;font-family:'Courier New',Courier,monospace;">
        {{value}}
      </p>
    </td>
  </tr>
</table>
