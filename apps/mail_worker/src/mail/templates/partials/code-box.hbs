<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:8px 0 20px;background:#f1f5ed;border:1px solid #cfe8a8;border-radius:10px;">
  <tr>
    <td align="center" style="padding:22px 16px;">
      {{#if label}}
      <p style="margin:0 0 10px;font-size:12px;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:#4e633a;">
        {{label}}
      </p>
      {{/if}}
      <p style="margin:0;font-size:28px;font-weight:800;letter-spacing:0.18em;line-height:1.2;color:#0a0a0a;font-family:'Courier New',Courier,monospace;">
        {{value}}
      </p>
    </td>
  </tr>
</table>
