<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:8px 0 20px;background:#fbfcf8;border-left:4px solid #5ba60b;border-radius:0 8px 8px 0;">
  <tr>
    <td style="padding:14px 16px;">
      {{#if title}}
      <p style="margin:0 0 6px;font-size:13px;font-weight:700;color:#3d6e08;">
        {{title}}
      </p>
      {{/if}}
      <p style="margin:0;font-size:13px;line-height:1.6;color:#4a4a4a;">
        {{{@partial-block}}}
      </p>
    </td>
  </tr>
</table>
