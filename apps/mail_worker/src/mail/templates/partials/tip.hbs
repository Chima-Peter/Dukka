<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:8px 0 20px;background:#F9F9F9;border-left:4px solid #FEB100;">
  <tr>
    <td style="padding:14px 16px;">
      {{#if title}}
      <p style="margin:0 0 6px;font-size:13px;font-weight:700;color:#0D523F;">
        {{title}}
      </p>
      {{/if}}
      <p style="margin:0;font-size:13px;line-height:1.6;color:#6B7373;">
        {{{@partial-block}}}
      </p>
    </td>
  </tr>
</table>
