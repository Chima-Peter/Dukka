<h1 style="margin:0 0 8px;font-size:26px;font-weight:800;line-height:1.25;color:#0a0a0a;">
  Your order has shipped
</h1>
<p style="margin:0 0 22px;font-size:14px;font-weight:600;letter-spacing:0.06em;text-transform:uppercase;color:#5ba60b;">
  On the way
</p>

<p style="margin:0 0 16px;">
  Hi {{name}},
</p>
<p style="margin:0 0 16px;">
  Your order <strong>#{{order_number}}</strong> is on its way.
  {{#if tracking_number}}
  Tracking number: <strong>{{tracking_number}}</strong>.
  {{/if}}
</p>

{{#> details}}
  {{> detail-row label="Order number" value=order_number}}
  {{> detail-row label="Status" value="Shipped"}}
  {{#if tracking_number}}
  {{> detail-row label="Tracking number" value=tracking_number}}
  {{/if}}
{{/details}}

{{#> tip title="Delivery updates"}}
  We will notify you again when your order is delivered. Keep an eye on your Dukka notifications for transit updates.
{{/tip}}

<p style="margin:0;">
  Thanks for shopping with Dukka. Reply to this email if you need help with this shipment.
</p>
