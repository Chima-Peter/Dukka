<h1 style="margin:0 0 8px;font-size:26px;font-weight:700;line-height:1.25;color:#0D523F;">
  Your market access was {{action}}
</h1>
<p style="margin:0 0 22px;font-size:12px;font-weight:600;letter-spacing:0.16em;text-transform:uppercase;color:#888B8B;">
  Market assignment
</p>

<p style="margin:0 0 16px;">
  Hi {{name}},
</p>
<p style="margin:0 0 16px;">
  Your market access on Dukka was <strong>{{action}}</strong>. Use the summary below to see which markets are now part of your workspace.
</p>

{{#if markets}}
<p style="margin:0 0 8px;font-size:14px;font-weight:700;color:#031815;">
  Markets
</p>
<ul style="margin:0 0 20px;padding-left:20px;color:#4B5555;">
  {{#each markets}}
  <li style="margin:0 0 6px;"><strong>{{name}}</strong> <span style="color:#6B7373;">({{code}})</span></li>
  {{/each}}
</ul>
{{/if}}

{{#if marketIds}}
<p style="margin:0 0 8px;font-size:14px;font-weight:700;color:#031815;">
  Market ids
</p>
<ul style="margin:0 0 20px;padding-left:20px;color:#4B5555;">
  {{#each marketIds}}
  <li style="margin:0 0 6px;">{{this}}</li>
  {{/each}}
</ul>
{{/if}}

{{#if roleId}}
{{#> details}}
  {{> detail-row label="Related role id" value=roleId}}
{{/details}}
{{/if}}

{{#> tip title="Why this matters"}}
  Market access controls which operational areas you can view and manage. If a market you need is missing, ask an administrator to adjust your assignment.
{{/tip}}

<p style="margin:0;">
  Your workspace reflects the latest market assignments.
</p>
