<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="color-scheme" content="light" />
  <meta name="supported-color-schemes" content="light" />
  <title>{{subject}}</title>
  <!--[if mso]>
  <style type="text/css">
    body, table, td { font-family: Arial, Helvetica, sans-serif !important; }
  </style>
  <![endif]-->
</head>
<body style="margin:0;padding:0;background:#F0F0F0;font-family:Urbanist,'Segoe UI',Helvetica,Arial,sans-serif;color:#4B5555;-webkit-font-smoothing:antialiased;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#F0F0F0;padding:28px 12px;">
    <tr>
      <td align="center">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;background:#ffffff;overflow:hidden;border:1px solid #E4E7E7;">
          <!-- Brand header -->
          <tr>
            <td style="background:#031815;padding:24px 32px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                <tr>
                  <td style="font-size:11px;font-weight:600;letter-spacing:0.22em;text-transform:uppercase;color:#FEB100;line-height:1.2;padding-bottom:8px;">
                    Dukka.Store
                  </td>
                </tr>
                <tr>
                  <td style="font-size:28px;font-weight:700;letter-spacing:-0.02em;color:#ffffff;line-height:1;">
                    Dukka
                  </td>
                  <td align="right" valign="bottom" style="font-size:11px;font-weight:600;letter-spacing:0.16em;text-transform:uppercase;color:#FEB100;line-height:1;">
                    Account notice
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          <!-- Accent bar -->
          <tr>
            <td style="height:3px;line-height:3px;font-size:0;background-color:#FEB100;">&nbsp;</td>
          </tr>
          <!-- Body -->
          <tr>
            <td style="padding:36px 32px 28px;font-size:15px;line-height:1.7;color:#4B5555;">
              {{{body}}}
            </td>
          </tr>
          <!-- Signature -->
          <tr>
            <td style="padding:0 32px 28px;">
              {{> signature}}
            </td>
          </tr>
          <!-- Footer -->
          <tr>
            <td style="background:#F5F6F5;border-top:1px solid #E4E7E7;padding:24px 32px;">
              <p style="margin:0 0 10px;font-size:13px;line-height:1.6;color:#6B7373;">
                Need help? Reply to this email or reach our support team — we are happy to assist.
              </p>
              <p style="margin:0 0 14px;font-size:12px;line-height:1.5;color:#888B8B;">
                This message was sent by Dukka.Store regarding your account activity. If you did not expect it, you can safely ignore it or contact support.
              </p>
              <p style="margin:0;font-size:12px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#0D523F;">
                Dukka.Store · Fresh finds for your market
              </p>
            </td>
          </tr>
        </table>
        <p style="margin:18px 0 0;font-size:11px;line-height:1.5;color:#888B8B;text-align:center;">
          © Dukka.Store. All rights reserved.
        </p>
      </td>
    </tr>
  </table>
</body>
</html>
