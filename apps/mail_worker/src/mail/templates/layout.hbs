<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="color-scheme" content="light" />
  <meta name="supported-color-schemes" content="light" />
  <title>{{subject}}</title>
</head>
<body style="margin:0;padding:0;background:#f3f4f0;font-family:'Segoe UI',Helvetica,Arial,sans-serif;color:#141414;-webkit-font-smoothing:antialiased;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f3f4f0;padding:28px 12px;">
    <tr>
      <td align="center">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;background:#ffffff;border-radius:12px;overflow:hidden;border:1px solid #e4e7df;box-shadow:0 8px 24px rgba(20,20,20,0.06);">
          <!-- Brand header -->
          <tr>
            <td style="background:#0a0a0a;padding:22px 32px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                <tr>
                  <td style="font-size:22px;font-weight:800;letter-spacing:0.04em;color:#ffffff;line-height:1;">
                    Dukka
                  </td>
                  <td align="right" style="font-size:11px;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;color:#8fd624;line-height:1;">
                    Account notice
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          <!-- Accent bar -->
          <tr>
            <td style="height:4px;line-height:4px;font-size:0;background-color:#5ba60b;">&nbsp;</td>
          </tr>
          <!-- Body -->
          <tr>
            <td style="padding:36px 32px 28px;font-size:15px;line-height:1.7;color:#2a2a2a;">
              {{{body}}}
            </td>
          </tr>
          <!-- Signature -->
          <tr>
            <td style="padding:0 32px 28px;">
              {{> signature}}
            </td>
          </tr>
          <!-- Footer -->
          <tr>
            <td style="background:#f7f8f4;border-top:1px solid #e4e7df;padding:24px 32px;">
              <p style="margin:0 0 10px;font-size:13px;line-height:1.6;color:#5c5c5c;">
                Need help? Reply to this email or reach our support team — we are happy to assist.
              </p>
              <p style="margin:0 0 14px;font-size:12px;line-height:1.5;color:#8a8a8a;">
                This message was sent by Dukka regarding your account activity. If you did not expect it, you can safely ignore it or contact support.
              </p>
              <p style="margin:0;font-size:12px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:#5ba60b;">
                Dukka · Built for markets that move
              </p>
            </td>
          </tr>
        </table>
        <p style="margin:18px 0 0;font-size:11px;line-height:1.5;color:#9ca3af;text-align:center;">
          © Dukka. All rights reserved.
        </p>
      </td>
    </tr>
  </table>
</body>
</html>
