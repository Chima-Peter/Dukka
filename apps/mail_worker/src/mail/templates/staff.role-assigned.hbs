<p style="margin:0 0 16px;">Hi {{name}},</p>
<p style="margin:0 0 16px;">Your staff role has been updated for <strong>{{email}}</strong>.</p>
{{#if roleName}}
<p style="margin:0;">New role: <strong>{{roleName}}</strong>.</p>
{{else}}
<p style="margin:0;">Role id: <strong>{{roleId}}</strong>.</p>
{{/if}}
