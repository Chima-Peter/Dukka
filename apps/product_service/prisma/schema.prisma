// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id   String @id @default(uuid())
  name String @unique

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  product Product[]
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  REJECTED
  ARCHIVED
}

model Product {
  id          String        @id @default(uuid())
  name        String
  description String
  specs       Json
  status      ProductStatus @default(DRAFT)

  images   ProductImage[]
  variants Variant[]
  market   MarketProduct[]

  category_id String
  category    Category @relation(fields: [category_id], references: [id], onDelete: Restrict)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model ProductImage {
  id         String @id @default(uuid())
  image_url  String
  sort_order Int    @default(0)

  product_id String
  product    Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Variant {
  id           String        @id @default(uuid())
  variant_code String        @unique
  image        VariantImage?
  color        String?
  size         String?
  variant_info Json

  product_id String
  product    Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  market_price MarketPrice[]
  inventory    Inventory[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model VariantImage {
  id        String @id @default(uuid())
  image_url String

  variant_id String  @unique
  variant    Variant @relation(fields: [variant_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model MarketProduct {
  id         String  @id @default(uuid())
  market_id  String
  product_id String
  product    Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([market_id, product_id])
}

model MarketPrice {
  id       String  @id @default(uuid())
  price    Decimal @db.Decimal(12, 2)
  currency String

  market_id  String
  variant_id String
  variant    Variant @relation(fields: [variant_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([market_id, variant_id])
}

enum WarehouseStatus {
  OPEN
  CLOSED
}

model Warehouse {
  id         String          @id @default(uuid())
  market_id  String
  name       String
  manager_id String
  address    String
  status     WarehouseStatus @default(OPEN)

  inventory Inventory[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Inventory {
  id                 String @id @default(uuid())
  available_quantity Int    @default(0)
  reserved_quantity  Int    @default(0)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  variant_id   String
  variant      Variant   @relation(fields: [variant_id], references: [id], onDelete: Cascade)
  warehouse_id String
  warehouse    Warehouse @relation(fields: [warehouse_id], references: [id], onDelete: Cascade)

  @@unique([warehouse_id, variant_id])
}
